{
    "name": "ZizaLend-scripts",
    "version": "1.0.0",
    "description": "Deployment and maintenance scripts for ZizaLend contracts",
    "main": "index.js",
    "scripts": {
        "deploy": "ts-node deploy.ts",
        "typecheck": "tsc --noEmit",
        "issues:check": "node publish-issues.mjs",
        "issues:publish": "node publish-issues.mjs --apply --close-missing",
        "benchmark:gas": "ts-node --project tsconfig.json benchmark-gas.ts",
        "benchmark:size": "node check-wasm-size.mjs"
    },
    "dependencies": {
        "@stellar/stellar-sdk": "^17.1.0",
        "dotenv": "^16.4.5",
        "fs-extra": "^11.4.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^20.12.7",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5"
    },
    "overrides": {
        "axios": "1.13.5"
    }
}
