{
  "name": "zizalend-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "start": "next start",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "audit:a11y": "next build && npx axe-playwright",
    "format": "prettier --write .",
    "test": "jest",
    "test:coverage": "jest --coverage && node ../scripts/check-coverage-thresholds.mjs --project frontend",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.0",
    "@serwist/next": "^9.5.12",
    "@serwist/precaching": "^9.5.12",
    "@serwist/sw": "^9.5.12",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.3.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lottie-react": "^2.4.2",
    "lucide-react": "^0.575.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-playwright": "^2.2.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "axios": "1.13.5"
  }
}
