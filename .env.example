# ── ZizaLend — Environment Configuration (local development template) ─────────
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# Every variable the backend validates at startup is listed below; a missing or
# blank value makes the process exit with a FATAL ERROR before it serves
# traffic. See docs/ENVIRONMENT.md for detailed documentation on each variable,
# and the per-package templates for stack-specific notes:
#   backend/.env.example   frontend/.env.example

# ── Runtime ───────────────────────────────────────────────────────
# development | production | test | staging
NODE_ENV=development
PORT=3001

# ── Backend — datastores ──────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ZizaLend
# Optional. Without it the cache and rate limiter use an in-process store, so
# state is per-instance and is lost on restart. Set it for multi-instance use.
REDIS_URL=redis://localhost:6379
# auto (default) | redis | memory — see backend/.env.example
CACHE_DRIVER=auto

# ── Backend — auth & internal APIs ────────────────────────────────
# Signing key for user JWTs. Must be a long random string; never commit a real one.
JWT_SECRET=replace-me-with-a-long-random-secret
# Comma-separated key(s) that unlock /metrics and admin routes.
# Scoped form is "<namespace>:<action>:<value>", e.g. admin:indexer:my-key
INTERNAL_API_KEY=replace-me-with-an-internal-api-key

# Frontend origin allowed by CORS. Required in production.
FRONTEND_URL=http://localhost:3000

# ── Stellar network ───────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Secret key of the account that deploys contracts and signs governance ops.
STELLAR_ADMIN_SECRET=

# ── Soroban contract IDs (set after deployment via scripts/deploy.ts) ──
LOAN_MANAGER_CONTRACT_ID=
LENDING_POOL_CONTRACT_ID=
REMITTANCE_NFT_CONTRACT_ID=
MULTISIG_GOVERNANCE_CONTRACT_ID=
# Address of the pool's LP token
POOL_TOKEN_ADDRESS=
# Secret the backend uses to sign loan-manager admin operations
LOAN_MANAGER_ADMIN_SECRET=

# ── Credit-score deltas (required) ────────────────────────────────
SCORE_DELTA_REPAY=10
SCORE_DELTA_DEFAULT=-50
SCORE_DELTA_LATE=-10

# ── Observability (optional) ──────────────────────────────────────
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Frontend (injected at build time; never put secrets here) ─────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert

# Mirror of the contract IDs above, for browser-side reads
NEXT_PUBLIC_MANAGER_CONTRACT_ID=
NEXT_PUBLIC_LOAN_MANAGER_CONTRACT_ID=
NEXT_PUBLIC_NFT_CONTRACT_ID=

# ── Smart contracts ───────────────────────────────────────────────
# Admin wallet key for contract governance operations (hex-encoded secret)
CONTRACT_ADMIN_SECRET=

# ── Docker (optional) ─────────────────────────────────────────────
# Override defaults when running via docker-compose
# COMPOSE_PROJECT_NAME=zizalend
